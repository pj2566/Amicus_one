# Supabase project (Settings -> API Keys). Service role key bypasses RLS: never ship it to the frontend.
SUPABASE_URL=https://kpilkcpfjklxwcbcicpc.supabase.co
SUPABASE_SERVICE_KEY=

# AI provider: vertex (Gemini via Google Cloud, default) or groq
LLM_PROVIDER=vertex

# Vertex AI — authenticates with ADC, no API key.
# Locally: gcloud auth application-default login   (as an account with access to the project)
# On Cloud Run: uses the service's service account automatically.
GOOGLE_CLOUD_PROJECT=jityai-507114
# asia-south1 keeps data in India. gemini-3.7/3.8-flash are only on 'global'.
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash

# Groq — only needed when LLM_PROVIDER=groq. GROQ_API_KEY_2 is used when the first key is rate limited.
GROQ_API_KEY=
GROQ_API_KEY_2=

PORT=3001
